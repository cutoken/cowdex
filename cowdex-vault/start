#!/usr/bin/env bash
set -euo pipefail
vault_source="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
vault_home="${COWDEX_VAULT_HOME:-$HOME/.local/share/cowdex-vault}"
umask 077
if [[ ! -x "$vault_home/.venv/bin/python" ]]; then
    python3 -m venv "$vault_home/.venv"
    "$vault_home/.venv/bin/python" -m pip install -r "$vault_source/requirements.txt"
fi
exec "$vault_home/.venv/bin/python" "$vault_source/web.py" "$@"
